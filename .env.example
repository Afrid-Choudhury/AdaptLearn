# Supabase Configuration
# Get these from your Supabase project dashboard: https://app.supabase.com
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Resend API Configuration (Server-side only, used in Edge Functions)
# Get this from: https://resend.com/api-keys
RESEND_API_KEY=re_YourResendApiKey

# Note: In production, set RESEND_API_KEY in Supabase Edge Function secrets
# The VITE_ prefixed variables should be set in your hosting provider (Vercel, etc.)
